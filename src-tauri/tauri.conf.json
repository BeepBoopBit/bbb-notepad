{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "bbb-notepad",
  "version": "0.2.0-beta",
  "identifier": "dev.bbb.notes",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "bbb-notepad",
        "width": 1000,
        "height": 700,
        "minWidth": 540,
        "minHeight": 360,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDFCNUNBNzNCNzY1RTQ3NUYKUldSZlIxNTJPNmRjRzA4RVplWWRIaW9qOWhlOWcwWjhBOUpxS1E2bGxBZ3JSMGV3V3UzL0luVzYK",
      "endpoints": [],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
